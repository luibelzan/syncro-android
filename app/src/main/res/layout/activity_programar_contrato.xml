<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProgramarContratoActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutBluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="30dp"
            android:paddingBottom="30dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:textColor="@color/gris_texto"
                android:text="@string/tarifContract"
                android:paddingBottom="15sp"/>

            <Spinner
                android:id="@+id/spinnerContrato"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:textColor="@color/gris_texto"
                android:text="@string/tarif"
                android:paddingTop="25sp"
                android:paddingBottom="10sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/checkBoxTarif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <Spinner
                    android:id="@+id/spinnerTarif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:textColor="@color/gris_texto"
                android:text="@string/powerLimit"
                android:paddingTop="15sp"
                android:paddingBottom="10sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="20dp">

                <CheckBox
                    android:id="@+id/checkBoxPowerLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <TextView
                    android:id="@+id/LimitT1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="20dp"
                    android:textSize="20sp"
                    android:text="@string/t1"/>

                <EditText
                    android:id="@+id/editPowerLimitT1"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/borde_radio_group"
                    android:hint="@string/powerInput" />

                <TextView
                    android:id="@+id/LimitT4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="20sp"
                    android:text="@string/t4"/>

                <EditText
                    android:id="@+id/editPowerLimitT4"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/borde_radio_group"
                    android:hint="@string/powerInput" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="50dp"
                android:paddingEnd="0dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/LimitT2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="20dp"
                    android:textSize="20sp"
                    android:text="@string/t2"/>

                <EditText
                    android:id="@+id/editPowerLimitT2"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/borde_radio_group"
                    android:hint="@string/powerInput" />

                <TextView
                    android:id="@+id/LimitT5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="20sp"
                    android:text="@string/t5"/>

                <EditText
                    android:id="@+id/editPowerLimitT5"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/borde_radio_group"
                    android:hint="@string/powerInput" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="50dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/LimitT3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="20dp"
                    android:textSize="20sp"
                    android:text="@string/t3"/>

                <EditText
                    android:id="@+id/editPowerLimitT3"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/borde_radio_group"
                    android:hint="@string/powerInput" />

                <TextView
                    android:id="@+id/LimitT6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="20sp"
                    android:text="@string/t6"/>

                <EditText
                    android:id="@+id/editPowerLimitT6"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/borde_radio_group"
                    android:hint="@string/powerInput" />
            </LinearLayout>

            <TextView
                android:id="@+id/textFechaAct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fechaAct"
                android:textColor="@color/gris_texto"
                android:textSize="18sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkBoxFechaAct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <EditText
                    android:id="@+id/editFechaAct"
                    android:layout_width="150dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/borde_radio_group"
                    android:focusable="false"
                    android:clickable="true"
                    android:textSize="15dp"
                    android:hint="@string/dateInput" />

                <EditText
                    android:id="@+id/editHourAct"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/borde_radio_group"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Hora"/>
            </LinearLayout>

            <TextView
                android:id="@+id/textFechaFact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cierreFact"
                android:textColor="@color/gris_texto"
                android:textSize="18sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/checkBoxFechaFact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <EditText
                    android:id="@+id/editFechaFactYear"
                    android:layout_width="70dp"
                    android:layout_height="44dp"
                    android:background="@drawable/borde_radio_group"
                    android:focusable="false"
                    android:clickable="false"
                    android:enabled="false"
                    android:text="FFFF"
                    android:gravity="center"
                    android:inputType="none"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"/>

                <EditText
                    android:id="@+id/editFechaFactMonth"
                    android:layout_width="55dp"
                    android:layout_height="44dp"
                    android:background="@drawable/borde_radio_group"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="MM"
                    android:gravity="center"
                    android:inputType="none"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"/>

                <EditText
                    android:id="@+id/editFechaFactDay"
                    android:layout_width="55dp"
                    android:layout_height="44dp"
                    android:background="@drawable/borde_radio_group"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="DD"
                    android:gravity="center"
                    android:inputType="none"/>

            </LinearLayout>

            <!-- Botón centrado -->
            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:background="@drawable/circle_button"
                android:contentDescription="@string/next"
                android:src="@android:drawable/ic_media_next"
                app:tint="@color/gris_texto" />

        </LinearLayout>
    </ScrollView>

    <!-- Progress overlay — encima de todo, oculto por defecto -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FF2C2C2E"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="true"/>

            <TextView
                android:id="@+id/textProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Programando contrato..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>