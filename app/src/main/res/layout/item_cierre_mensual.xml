<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_row_fila"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvFecha"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="Fecha"
        android:textSize="13sp"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tvFechaFin"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="Fecha Fin"
        android:textSize="13sp"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tvContrato"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:text="Contrato"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvPeriodo"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:text="Periodo"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvMaxAIi"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="Max AIi"
        android:textSize="13sp"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tvFechaMaxAIi"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="Fecha Max"
        android:textSize="13sp"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tvActImpAbs"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="AI abs"
        android:textSize="13sp"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tvActExpAbs"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="AE abs"
        android:textSize="13sp"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tvR1Abs"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="R1"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvR2Abs"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="R2"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvR3Abs"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="R3"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvR4Abs"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="R4"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvActImpInc"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="AI inc"
        android:textSize="13sp"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tvActExpInc"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="AE inc"
        android:textSize="13sp"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/tvR1Inc"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="R1 inc"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvR2Inc"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="R2 inc"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvR3Inc"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:text="R3 inc"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tvR4Inc"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="R4 inc"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

</LinearLayout>