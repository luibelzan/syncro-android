<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".PrimeSeguridadActivity">

    <!-- Cabecera -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:text="@string/primeSeguridad"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/outline"
        app:layout_constraintEnd_toEndOf="@id/textView"
        app:layout_constraintStart_toStartOf="@id/textView"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp">

            <!-- Tarjeta: Constelación / Codificación -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Checkbox maestro / título de sección -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbConstellationMaster"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Prime 1.4 constellation/coding"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:buttonTint="@color/primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/outline" />

                    <!-- Dos columnas de bits -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Columna izquierda: bit 0 - bit 8 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit0"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 0: DBPSK"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 1: RES"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 2: DQPSK"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 3: D8PSK"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 4: RES"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 5: DBPSK_C"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 6: DQPSK_C"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit7"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 7: D8PSK_C"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit8"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 8: RES"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                        </LinearLayout>

                        <!-- Columna derecha: bit 9 - bit 15 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit9"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 9: RES"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit10"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 10: RES"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit11"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 11: RES"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit12"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 12: R_DBPSK"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit13"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 13: R_DQPSK"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit14"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 14: RES"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbBit15"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="bit 15: RES"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                app:buttonTint="@color/primary" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Tarjeta: macMaxBandSearchTime (movida desde Canal PRIME) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkBoxMacMax"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Prime 1.4 macMaxBandSearchTime"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:buttonTint="@color/primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editMacMaxBandSearchTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/on_surface" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Tarjeta: macMinBandSearchTime (movida desde Canal PRIME) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkBoxMacMin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Prime 1.4 macMinBandSearchTime"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:buttonTint="@color/primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editMacMinBandSearchTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/on_surface" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Overlay de progreso -->
    <include
        android:id="@+id/progressContainer"
        layout="@layout/overlay_progress"
        android:elevation="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botones de acción -->
    <LinearLayout
        android:id="@+id/botonera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnLeerActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/leer_actual"
            android:textColor="@color/primary"
            app:backgroundTint="@color/surface"
            app:icon="@android:drawable/ic_menu_view"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnProgramar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/programar"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>