<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PantallaActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/screenParams"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/gris_texto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutBluetooth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView">

        <TextView
            android:id="@+id/textTiempoDesplazamiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editTiempoDesplazamiento"
            android:textColor="@color/gris_texto"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTiempoDesplazamiento"
            android:layout_width="250dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/borde_radio_group"
            android:clickable="true"
            android:hint="4"
            android:text="4"/>

        <TextView
            android:id="@+id/textModoDesplazamiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editModoDesplazamiento"
            android:textColor="@color/gris_texto"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editModoDesplazamiento"
            android:layout_width="250dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/borde_radio_group"
            android:clickable="true"
            android:hint="A"
            android:text="A"/>

    </LinearLayout>

    <!-- Contenedor para ProgressBar y texto -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutBluetooth"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>

        <TextView
            android:id="@+id/textCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="@color/gris_texto"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>


    <!-- Contenedor de los dos botones -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="116dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón leer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingEnd="30dp"
            android:layout_marginEnd="32dp">

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="center"
                android:contentDescription="@string/next"
                android:src="@drawable/leer_pantalla"
                android:background="@android:color/transparent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Leer"
                android:textColor="@color/gris_texto"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Botón programar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnProgram"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="center"
                android:contentDescription="@string/next"
                android:src="@drawable/programar_pantalla"
                android:background="@android:color/transparent"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Programar"
                android:textColor="@color/gris_texto"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>