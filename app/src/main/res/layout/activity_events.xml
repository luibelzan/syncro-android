<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".EventsActivity">

    <!-- Cabecera -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:text="@string/events"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/outline"
        app:layout_constraintEnd_toEndOf="@id/textView"
        app:layout_constraintStart_toStartOf="@id/textView"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader">

        <!-- Tarjeta de formulario -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Fecha inicio -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutFechaInicio"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/fechainicio"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                    app:endIconTint="@color/primary">

                    <EditText
                        android:id="@+id/editFechaInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Fecha fin -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutFechaFin"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/fechafin"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                    app:endIconTint="@color/primary">

                    <EditText
                        android:id="@+id/editFechaFin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tipo de evento -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/tipoEvent"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lista_eventos"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <!-- ===== Estándar (desplegable) ===== -->
                    <LinearLayout
                        android:id="@+id/wrapperEstandar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbEstandar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:text="Estándar"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp"
                                app:buttonTint="@color/primary" />

                            <ImageButton
                                android:id="@+id/btnExpandEstandar"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/expandir"
                                android:src="@android:drawable/arrow_down_float"
                                app:tint="@color/on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/groupEstandar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="40dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbStandard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="General"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbImpPowContract"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Contrato de potencia (importación)"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbFirmware"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Firmware"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbSync"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sincronización"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbExpPowContract"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Contrato de potencia (exportación)"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />
                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/outline" />

                    <!-- ===== ICP (simple) ===== -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbIcp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="ICP"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        app:buttonTint="@color/primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/outline" />

                    <!-- ===== Calidad (desplegable) ===== -->
                    <LinearLayout
                        android:id="@+id/wrapperCalidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbCalidad"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:text="Calidad"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp"
                                app:buttonTint="@color/primary" />

                            <ImageButton
                                android:id="@+id/btnExpandCalidad"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/expandir"
                                android:src="@android:drawable/arrow_down_float"
                                app:tint="@color/on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/groupCalidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="40dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbPowerQuality"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Calidad de suministro"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbFinishedPQ"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fin de evento de calidad"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />
                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/outline" />

                    <!-- ===== Fraude (simple) ===== -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbFraude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Fraude"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        app:buttonTint="@color/primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/outline" />

                    <!-- ===== Demanda (simple) ===== -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbDemanda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Demanda"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        app:buttonTint="@color/primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/outline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/outline" />

                    <!-- ===== Comunicaciones (simple) ===== -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbComunicaciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Comunicaciones"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        app:buttonTint="@color/primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/outline" />

                    <!-- ===== Seguridad (desplegable) ===== -->
                    <LinearLayout
                        android:id="@+id/wrapperSeguridad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbSeguridad"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:text="Seguridad"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp"
                                app:buttonTint="@color/primary" />

                            <ImageButton
                                android:id="@+id/btnExpandSeguridad"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/expandir"
                                android:src="@android:drawable/arrow_down_float"
                                app:tint="@color/on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/groupSeguridad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="40dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbSecurityCorrect"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Operaciones de seguridad correctas"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbSecurityFailed"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Operaciones de seguridad fallidas"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="14sp"
                                app:buttonTint="@color/primary" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.core.widget.NestedScrollView>

    <!-- Overlay de progreso -->
    <include
        android:id="@+id/progressContainer"
        layout="@layout/overlay_progress"
        android:elevation="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón siguiente -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="24dp"
        android:text="@string/next"
        android:textColor="@color/white"
        app:icon="@android:drawable/ic_media_next"
        app:iconTint="@color/white"
        app:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>